# =============================================================================
# SUPABASE - CLIENT-SIDE CONFIGURATION
# These variables are exposed to the browser (NEXT_PUBLIC_ prefix)
# Only use public/anon keys here - never expose service role keys
# =============================================================================

# Public Supabase Project URL - Safe to expose to client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co/

# Public Supabase Anon Key - Safe to expose to client (limited permissions)
# This key has read permissions on the servers table
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Supported deployment aliases used by this app when the NEXT_PUBLIC variables
# are not available in a given hosting environment.
# NEXT_SUPABASE_DB_URL=https://your-project-ref.supabase.co/
# NEXT_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# SUPABASE - SERVER-SIDE ONLY CONFIGURATION
# These variables are NEVER exposed to the client
# Keep these secrets secure and only use in server-side code (API routes, etc)
# =============================================================================

# Service Role Key - NEVER expose to client (full database access)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Supported server-side aliases:
# NEXT_SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx
# SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# Supabase JWT Secret - NEVER expose to client (used for token verification)
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET_HERE

# Database connection strings - NEVER expose to client
DIRECT_CONNECTION_STRING=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_SUPABASE_HOST.supabase.co:5432/postgres
DATABASE_PASSWORD=YOUR_DB_PASSWORD_HERE

# JWKS ID for token validation - Server-side only
SUPABASE_JWKS=YOUR_JWKS_ID_HERE

# =============================================================================
# API & APPLICATION CONFIGURATION
# =============================================================================

# API endpoint routing (can be public)
PUBLIC_API_URL=/api

# Sync Token for securing the server sync endpoint (optional but recommended)
# Generate a strong random string for this value
# Used to secure the /api/sync-servers endpoint against unauthorized access
SYNC_TOKEN=your-secure-random-token-here

# Otservlist import defaults
# OTSERVLIST_PAGE_LIMIT=4
# OTSERVLIST_INCLUDE_DETAILS=true
# OTSERVLIST_DETAIL_LIMIT=100
# OTSERVLIST_OFFICIAL_RESEARCH_LIMIT=100
# OTSERVLIST_OFFICIAL_TIMEOUT_MS=15000

# Project URLs
PROJECT_URL=https://your-project-ref.supabase.co/

# =============================================================================
# STRIPE INTEGRATION (for future use)
# These are placeholder names for when stripe integration is added
# =============================================================================

# Public key - can be exposed to client
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Secret key - NEVER expose to client (server-only)
# STRIPE_SECRET_KEY=sk_live_...

# =============================================================================
# AUTHENTICATION & SECURITY
# These are reserved for future authentication/integration setup
# =============================================================================

# Auth service keys - Server-side only
# PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
# SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# DEPLOYMENT & ENVIRONMENT
# =============================================================================

# NODE_ENV=production
# or development/staging during development
